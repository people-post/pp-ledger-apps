<rml>
<head>
  <title>Send</title>
  <link type="text/rcss" href="../themes/apps.rcss"/>
</head>
<body>
  <div class="bar" data-model="nav">
    <span class="app">{{app}}</span>
    <span class="tab" data-for="tab : tabs" data-attr-id="'nav-' + tab.id" data-class-current="current == tab.id" data-event-click="nav_go(tab.id)">{{tab.title}}</span>
    <span class="spacer"></span>
    <span class="status" data-if="status != ''">{{status}}</span>
    <span id="nav-lock" class="tab" data-event-click="nav_lock()">Lock</span>
  </div>
  <div class="page" data-model="send">
    <div class="card">
      <h1>Send from the issuer</h1>
      <p class="muted">It holds: {{holdings}}. Its own token is issued (Issue), not sent from here.</p>
      <label>Token (its number; empty: the native token)</label>
      <input id="send-token" class="field" type="text" data-value="token" data-attrif-disabled="busy"/>
      <label>To account (its number)</label>
      <input id="send-to" class="field" type="text" data-value="to" data-attrif-disabled="busy"/>
      <div class="row">
        <div class="grow">
          <label>Amount</label>
          <input id="send-amount" class="field" type="text" data-value="amount" data-attrif-disabled="busy"/>
        </div>
        <div class="grow">
          <label>Fee (native)</label>
          <input id="send-fee" class="field" type="text" data-value="fee" data-attrif-disabled="busy"/>
        </div>
      </div>
      <div class="row">
        <div class="grow">
          <label>Hours the signers have</label>
          <input id="form-hours" class="field" type="text" data-value="valid_hours" data-attrif-disabled="busy"/>
        </div>
        <div class="grow">
          <label>Notes for the signers (optional, shown as yours)</label>
          <input id="form-notes" class="field" type="text" data-value="notes" data-attrif-disabled="busy"/>
        </div>
      </div>
      <button id="send-make" class="primary" data-event-click="send_make()" data-attrif-disabled="busy">Make the operation…</button>
      <p class="notice" data-if="notice != ''">{{notice}}</p>
      <p class="error" data-if="error != ''">{{error}}</p>
    </div>
  </div>
</body>
</rml>
