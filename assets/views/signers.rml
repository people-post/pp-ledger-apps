<rml>
<head>
  <title>Signers</title>
  <link type="text/rcss" href="../themes/admin.rcss"/>
</head>
<body>
  <div class="bar" data-model="nav">
    <span class="app">{{app}}</span>
    <span class="tab" data-for="tab : tabs" data-attr-id="'nav-' + tab.id" data-class-current="current == tab.id" data-event-click="nav_go(tab.id)">{{tab.title}}</span>
    <span class="spacer"></span>
    <span class="status" data-if="status != ''">{{status}}</span>
    <span id="nav-lock" class="tab" data-event-click="nav_lock()">Lock</span>
  </div>
  <div class="page" data-model="signers">
    <div class="card">
      <h1>The issuer's signers</h1>
      <p class="muted">In force: {{current}}. Choose the keys from then on and how many must sign; the keys
        in force sign the change. Others' keys come from their key cards (account owner keys).</p>
      <div class="item" data-for="candidate : candidates">
        <input type="checkbox" data-attr-id="'signer-' + it_index" data-checked="candidate.chosen" data-attrif-disabled="busy"/>
        <span class="grow">{{candidate.name}}</span>
      </div>
      <div class="row" style="margin: 8dp 0 12dp 0;">
        <button id="signers-card" data-event-click="signers_card()" data-attrif-disabled="busy">Add a key card…</button>
      </div>
      <div class="row">
        <div class="grow">
          <label>Signatures needed</label>
          <input id="signers-threshold" class="field" type="text" data-value="threshold" data-attrif-disabled="busy"/>
        </div>
        <div class="grow">
          <label>Fee</label>
          <div class="row">
            <input id="signers-fee" class="field grow" type="text" data-value="fee" data-attrif-disabled="busy"/>
            <button id="signers-least" style="margin-bottom: 12dp;" data-event-click="signers_fee()" data-attrif-disabled="busy">Work it out</button>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="grow">
          <label>Hours the signers have</label>
          <input id="form-hours" class="field" type="text" data-value="valid_hours" data-attrif-disabled="busy"/>
        </div>
        <div class="grow">
          <label>Notes for the signers (optional, shown as yours)</label>
          <input id="form-notes" class="field" type="text" data-value="notes" data-attrif-disabled="busy"/>
        </div>
      </div>
      <button id="signers-make" class="primary" data-event-click="signers_make()" data-attrif-disabled="busy">Make the change…</button>
      <p class="notice" data-if="notice != ''">{{notice}}</p>
      <p class="error" data-if="error != ''">{{error}}</p>
    </div>
  </div>
</body>
</rml>
