<rml>
<head>
  <title>Transfer</title>
  <link type="text/rcss" href="../themes/apps.rcss"/>
</head>
<body>
  <div class="bar" data-model="nav">
    <span class="app">{{app}}</span>
    <span class="tab" data-for="tab : tabs" data-attr-id="'nav-' + tab.id" data-class-current="current == tab.id" data-event-click="nav_go(tab.id)">{{tab.title}}</span>
    <span class="spacer"></span>
    <span class="status" data-if="status != ''">{{status}}</span>
    <span id="nav-lock" class="tab" data-event-click="nav_lock()">Lock</span>
  </div>
  <div class="page" data-model="transfer">
    <div class="card">
      <h1>New transfer from the {{from}}</h1>
      <p class="muted">Balance {{balance}} · signed by {{signers}} of its holders</p>
      <label>To account (its number)</label>
      <input id="transfer-to" class="field" type="text" data-value="to" data-attrif-disabled="busy"/>
      <label>Amount</label>
      <input id="transfer-amount" class="field" type="text" data-value="amount" data-attrif-disabled="busy"/>
      <div class="row">
        <div class="grow">
          <label>Fee</label>
          <input id="transfer-fee" class="field" type="text" data-value="fee" data-attrif-disabled="busy"/>
        </div>
        <div class="grow">
          <label>Hours the signers have</label>
          <input id="transfer-hours" class="field" type="text" data-value="valid_hours" data-attrif-disabled="busy"/>
        </div>
      </div>
      <label>Notes for the signers (optional, shown as yours)</label>
      <input id="transfer-notes" class="field" type="text" data-value="notes" data-attrif-disabled="busy"/>
      <button id="transfer-make" class="primary" data-event-click="transfer_make()" data-attrif-disabled="busy">Make the operation…</button>
      <p class="notice" data-if="notice != ''">{{notice}}</p>
      <p class="error" data-if="error != ''">{{error}}</p>
    </div>
  </div>
</body>
</rml>
