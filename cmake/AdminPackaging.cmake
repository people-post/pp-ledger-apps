# Packages (cpack): a .deb on Linux (the five apps, /usr), a .dmg on macOS (the five bundles).
set(CPACK_PACKAGE_NAME "pp-ledger-admin")
set(CPACK_PACKAGE_VENDOR "People Post")
set(CPACK_PACKAGE_CONTACT "pp-ledger-admin maintainers <noreply@github.com>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Desktop apps for the holders of a pp-ledger chain's system keys")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_COMPONENTS_ALL apps)
set(CPACK_STRIP_FILES ON)
if(APPLE)
  set(CPACK_GENERATOR "DragNDrop")
  set(CPACK_DMG_VOLUME_NAME "PP Ledger Admin")
  set(CPACK_DMG_FORMAT "UDZO")
  set(CPACK_PACKAGE_FILE_NAME "pp-ledger-admin-${PROJECT_VERSION}-macos-${CMAKE_SYSTEM_PROCESSOR}")
else()
  set(CPACK_GENERATOR "DEB")
  set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
  set(CPACK_DEBIAN_PACKAGE_SECTION "utils")
  set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
  # SDL loads the display and GL libraries at run time: name them; the rest dpkg-shlibdeps finds.
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_PACKAGE_DEPENDS "libgl1, libx11-6, libxext6, libxcursor1, libxi6, libxrandr2")
endif()
set(CPACK_ARCHIVE_COMPONENT_INSTALL OFF)
set(CPACK_DEB_COMPONENT_INSTALL OFF)
include(CPack)
