# Against a running chain: create an issued account for an owner (their pp-client .pub file), with its
# domain, funded by the registrar, signed with the vault's three registrar keys, submitted, seen in a block.
wait 5
click #unlock-passphrase
type registrar passphrase
click #unlock
idle
wait 5
click #nav-network
wait 3
click #network-address
type @NODE@
click #network-check
idle
wait 3
click #nav-account
idle
wait 5
click #registrar-id
type @ACCOUNT@
click #registrar-domain
type @DOMAIN@
answer @OUT@/owner.pub
click #registrar-pub
wait 3
idle
wait 3
click #registrar-amount
type @FUND@
shot @OUT@/9-new-account.png
answer @OUT@/account.json
click #registrar-make
idle
wait 5
answer @OUT@/account1.json
click #sign
wait 5
answer @OUT@/account2.json
click #sign
wait 5
answer @OUT@/account3.json
click #sign
wait 5
click #submit
idle
wait 5
expect #submit-done
quit
